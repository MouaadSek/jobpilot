# JobPilot configuration — copy to .env and fill in. .env is gitignored.

# ---- Paths (optional; sensible defaults relative to project root) ----
# JOBPILOT_DB=data/jobpilot.db
# JOBPILOT_LOG_DIR=logs
# Tailored HTML, PDFs, and tracker artifacts. Relative paths resolve from repo root.
# JOBPILOT_OUTPUT_DIR=output/applications

# ---- CV tailoring (interactive, Anthropic, or OpenAI-compatible) ----
# auto (default): Anthropic key, then OpenAI key, then interactive prompts.
# TAILORING_PROVIDER=auto
# Anthropic configuration.
ANTHROPIC_API_KEY=
# Pinned Claude Haiku 4.5 snapshot for reproducible tailoring output.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OpenAI configuration. OPENAI_BASE_URL can target a compatible hosted/local API.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Explicit anthropic/openai selection requires its key; there is no silent fallback.
#
# After installing JobPilot, install Chromium on both Windows and macOS:
# python -m playwright install chromium

# ---- ATS application assist (prefill only; the human submits) ----
# Used solely to fill a visible Lever, Greenhouse, or SmartRecruiters form.
# Set all four before using the dashboard action; missing values show a setup error.
APPLICANT_FULL_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_LINKEDIN_URL=

# ---- France Travail "Offres d'emploi v2" API ----
# Get credentials at https://francetravail.io (subscribe to the API).
# OAuth2 client_credentials flow.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Token + search endpoints are hardcoded in the client; override only if they change.
# FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
# FRANCE_TRAVAIL_SEARCH_URL=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
# FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
# Recency window in days for the search (allowed: 1, 3, 7, 14, 31). Default 31
# for backfill; tighten once daily runs keep the DB warm.
# FRANCE_TRAVAIL_PUBLISHED_SINCE=31

# ---- La Bonne Alternance (API Apprentissage) ----
# The legacy caller-email API is retired. The current API needs a Bearer token:
# register an account and generate a key at
# https://labonnealternance.apprentissage.beta.gouv.fr/espace-developpeurs
# The source is disabled in config/sources.yaml until this is set.
LBA_API_KEY=
# LBA_SEARCH_URL=https://api.apprentissage.beta.gouv.fr/api/job/v1/search
# Legacy, unused by the current client; kept for reference only.
LBA_CALLER_EMAIL=

# ---- Gmail (IMAP) for LinkedIn / Indeed job-alert ingestion ----
# Enable IMAP in Gmail, then create an App Password (requires 2FA):
# https://myaccount.google.com/apppasswords . Read-only; parses alert emails only.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional transport overrides; defaults shown.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_FOLDER=INBOX
# How many days back to scan for alert emails (default 7).
# EMAIL_ALERT_SINCE_DAYS=7
# Alert emails carry no real description. Below this many characters the stored
# description is composed from the alert's own fields (title, company, location,
# snippet) so the offer is scoreable at all. Default 120.
# ALERT_MIN_DESCRIPTION_CHARS=120
# The Gmail app password is redacted from logs and errors.

# ---- SMTP (send an application by email, after human confirmation) ----
# Used by `jobpilot send <id>` and the dashboard email flow. For Gmail, create an
# App Password (requires 2FA): https://myaccount.google.com/apppasswords .
# The password is redacted from all logs and errors, like the API keys.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_FROM_NAME=Mouaad Sekkouri
# Live cold outreach remains blocked until the owner explicitly signs off.
# The dashboard confirmation and all validation still work while false.
COLD_SEND_ENABLED=false

# ---- Welcome to the Jungle (Algolia) ----
# WTTJ powers search with Algolia. The public search key is injected client-side
# and rotates: open welcometothejungle.com job search with devtools Network open,
# find the request to *-dsn.algolia.net, and copy the X-Algolia-API-Key header.
WTTJ_API_KEY=
# Overridable defaults (change if WTTJ rotates the app id / index):
# WTTJ_APP_ID=CSEKHVMS53
# WTTJ_INDEX=wttj_jobs_production_c3_search
# Safety ceiling per search query (default 5):
# WTTJ_MAX_PAGES=5
# Inline apply is a dry run by default: it fills/uploads in a visible browser
# and captures a screenshot, but never clicks the final submit control.
# Set true only after explicitly opting into live submission. Human approval
# and all pre-submit safety checks remain mandatory in live mode.
WTTJ_AUTO_SUBMIT_ENABLED=false

# ---- Embeddings & scoring ----
# Local sentence-transformers model; no API key needed.
# JOBPILOT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# final_score >= this queues an offer for review (0..1). Default 0.35.
# matcher blends 0.50*semantic + 0.35*keyword + 0.15*bonus; French postings
# rarely name specific tools so keyword stays low, capping finals ~0.45-0.50.
# Raise toward 0.45 for higher precision, lower toward 0.35 for more recall.
# JOBPILOT_QUEUE_THRESHOLD=0.35
